{
  "name": "@bloombot/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Shared zod schemas. Depends on zod alone so it can be bundled into the browser (PLAT-2).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "yaml": "^2.5.0"
  }
}
