{
  "name": "@bloombot/openai",
  "version": "0.1.0",
  "private": true,
  "description": "The OpenAI Responses API adapter behind @bloombot/core's model port — the only package that knows a vendor exists (MDL-1..7).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@bloombot/config": "*",
    "@bloombot/core": "*",
    "@bloombot/logger": "*"
  },
  "devDependencies": {
    "@bloombot/db": "*"
  }
}
