{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Shared compiler settings for every workspace project (PLAT-1). Strict throughout, ESM throughout, and each package is a composite project so `tsc --build` can typecheck the graph in dependency order.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Import elision is never guessed: a type-only import must say `type`.
    // Without this, an erased import can silently drop a side-effecting module.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    // `arr[0]` is `T | undefined`. Off-by-one bugs become type errors instead of
    // runtime `undefined`s deep inside a request.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    // Project references need composite + declarations to build incrementally.
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  }
}
