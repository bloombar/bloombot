# Build output and dependencies.
node_modules/
dist/
.tsbuild/
coverage/
package-lock.json

# Generated: `npm run board:derive` writes this and the sync compares it byte for
# byte. Reformatting it would show up as a spurious board diff.
scripts/board/manifest.yaml

# Generated: `drizzle-kit generate` writes the migration SQL and its metadata.
# Reformatting them would diverge from what the next `generate` produces,
# turning every future migration into a spurious diff on top of the real one.
packages/db/migrations/

# Files this monorepo conversion did not author. Prettier disagrees with all of
# them, and reformatting them would bury the real change under whitespace. They
# can be brought in deliberately, as their own change.
.prettierrc
README.md
ecosystem.config.cjs
docs/
.claude/
scripts/board/*.mjs

# Real course configuration and real student data — comments, ordering and
# quoting in these are load-bearing, and a formatter has no business in them.
bot_config.yml
data/
logs/
results/
rosters/
questionnaires/

# Python side of the repository.
__pycache__/
.pytest_cache/
*.ipynb
