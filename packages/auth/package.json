{
  "name": "@bloombot/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Who is calling, with no HTTP in it — sign-in tokens, sessions, Google identity linking and the platform-administrator check (AUTH-1..4).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@bloombot/config": "*",
    "@bloombot/db": "*",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
