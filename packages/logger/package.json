{
  "name": "@bloombot/logger",
  "version": "0.1.0",
  "private": true,
  "description": "Pino logger factory writing JSONL per process, with pretty stdout in development (PLAT-5, BOT-10, OPS-3).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@bloombot/config": "*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
