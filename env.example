# Bloombot environment template.
#
# Copy to `.env` and fill in. `.gitignore` swallows every `.env*` variant because
# this repository is public and those files hold live credentials — this file,
# with no leading dot, is the tracked template.
#
# Every variable in the platform's configuration schema (packages/config) must
# appear here; a test enforces it, so the template cannot drift (QA-6).

# --- Platform (packages/config) -------------------------------------------

# Which deployment this process is: development | test | production.
NODE_ENV=development

# Minimum severity written to the logs: debug | info | warn | error | fatal.
LOG_LEVEL=info

# Directory the per-process JSONL log files are written into.
LOGS_DIR=./logs

# Development only: where sign-in emails are written, one JSON object per line.
# A sign-in link is a bearer credential — the ordinary stand-in logs only the
# recipient and subject, and tokens are stored hashed, so without this there is
# no way to complete a local sign-in. Refused outright when NODE_ENV=production,
# whether or not it is set (OPS-14). Leave blank in any real deployment.
MAIL_FILE=


# SQLite file holding users, messages and tenancy.
DATABASE_PATH=./data/data.db

# FILE-1..5 — directory a course attachment's own bytes are written under,
# keyed by an unguessable id rather than the instructor's own filename. Real
# course material, never committed — see .gitignore.
ATTACHMENT_STORAGE_DIR=./data/attachments

# The legacy Python bot reads the same database through SQL_LITE_DB_PATH, not
# DATABASE_PATH (models/base.py, migrate.py). It is not part of the TypeScript
# schema — nothing in packages/config reads it — but during the migration both
# variables must point at the same file, or the bot and the platform will
# write to two different databases without either side noticing.
SQL_LITE_DB_PATH=./data/data.db

# Public origin of the control panel, used to build links in outbound email.
PUBLIC_APP_URL=http://localhost:5173

# Port the Express API listens on.
API_PORT=3000

# Port the Discord bot's health endpoint listens on.
BOT_HEALTH_PORT=3001

# Port the background worker's health endpoint listens on (JOB-5).
WORKER_HEALTH_PORT=3002

# Port the MCP server listens on (MCP-1..5) — both its /mcp endpoint and its
# /health one.
MCP_PORT=3003

# Comma-separated platform administrator emails. Read on every check, so adding
# or removing an administrator takes effect without a deployment (AUTH-4).
ADMIN_EMAILS=

# --- Background jobs & admission (packages/jobs, apps/worker) -------------
#
# JOB-2/JOB-3: the queue's own claim lease and retry policy. See
# docs/DECISIONS.md for what these numbers are and why.
JOB_CLAIM_LEASE_MS=300000
JOB_RETRY_BASE_DELAY_MS=1000
JOB_RETRY_BACKOFF_FACTOR=2
JOB_POLL_INTERVAL_MS=2000
# Rework finding 5 — bounds how long one handler call may run before it is
# treated as a failed attempt, rather than awaited unbounded.
JOB_HANDLER_TIMEOUT_MS=240000

# JOB-4: bounds concurrent model calls in packages/core's answering path, and
# how long a request waits for a slot before it is told it could not be
# served rather than left hanging.
MODEL_ADMISSION_LIMIT=5
MODEL_ADMISSION_WAIT_MS=15000

# COST-1/COST-6: per-model rates the cost ledger prices token counts
# against, as JSON (packages/config/src/pricing.ts has the shape and why
# each rate is integer micros per million tokens, not a float). Left empty
# here — packages/config/src/pricing.ts's own documented default (an
# approximate, publicly listed OpenAI rate) applies whenever this is unset,
# the same "defaults to the real thing" shape OPENAI_BASE_URL below takes.
MODEL_PRICING_JSON=

# --- Upstream base URLs ----------------------------------------------------
#
# These default to the real services and need no value in production. They exist
# so tests can point every outbound call at a fake upstream, which is how no
# vendor host ends up hardcoded in a client (QA-2).

DISCORD_API_BASE=https://discord.com/api/v10
DISCORD_OAUTH_BASE=https://discord.com/api/oauth2
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_ISSUER=https://accounts.google.com

# Google OAuth client id, checked as the `aud` claim on every verified Google
# ID token (AUTH-2). Left empty in development; the real verifier refuses
# every token when this is unset rather than accepting any audience.
GOOGLE_CLIENT_ID=

# --- Discord and OpenAI credentials (CFG-5) --------------------------------
#
# Used by the Python bot today and by the TypeScript processes as they land. The
# bot token must belong to an application with the Server Members and Message
# Content privileged intents enabled.
#
# BOT_PERMISSIONS is the permission integer the install link asks a server
# administrator to grant. Scaffolding a course needs all of these:
#
#     View Channels        1024
#     Send Messages        2048
#     Read Message History 65536
#     Manage Channels         16   (create categories and channels)
#     Manage Roles     268435456   (set the overwrites that make a course private)
#     ------------------------------
#     BOT_PERMISSIONS  268504080
#
# Grant less and scaffolding fails partway with a 403. If you already invited
# the bot with a narrower integer, changing this value is not enough — Discord
# fixes a bot's permissions at invite time, so re-invite through the panel's
# own Install to Discord link to apply the new set.
#
# Every key below whose name matches TOKEN|KEY|SECRET|PASSWORD|CREDENTIAL is
# left empty rather than given a placeholder value — a test enforces this, so
# a pasted real credential is a red build instead of a leak (QA-6).

BOT_APP_ID=your_bot_app_id
BOT_PUBLIC_KEY=
BOT_TOKEN=
BOT_PERMISSIONS=your_bot_permissions_integer
OPENAI_API_KEY=

# TEN-4 — the Discord install flow's OAuth2 client secret, read by apps/api
# (never packages/config's schema — a credential, CFG-5). BOT_APP_ID above
# doubles as the OAuth "client id": Discord's own client id and application
# id are the same value.
DISCORD_CLIENT_SECRET=

# --- Operator notification (OPS-12) ----------------------------------------
#
# scripts/ops-monitor.mjs polls every process's own /health endpoint and
# notifies on a healthy/unhealthy transition — a Discord or Slack incoming
# webhook URL, not part of packages/config's schema (it is read directly by
# that script alone, the same CFG-5 "read outside the schema" shape
# BOT_TOKEN/OPENAI_API_KEY already take for apps/bot). Left blank in
# development: with nothing configured, a transition is still written to
# logs/ops-monitor.log rather than lost — see that script's own module
# comment.
OPS_ALERT_WEBHOOK_URL=

# How often scripts/ops-monitor.mjs polls, in milliseconds. Defaults to 30000
# (30s) when unset.
OPS_ALERT_POLL_INTERVAL_MS=
